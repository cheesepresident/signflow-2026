package web

import "fmt"

templ DocumentList(docs []DocumentView) {
	<section id="doc-list" class="card">
		<h2>Documents</h2>
		if len(docs) == 0 {
			<p class="muted">No documents yet. Upload one above to get started.</p>
		} else {
			<table class="table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Status</th>
						<th>Size</th>
						<th>Uploaded</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, d := range docs {
						@documentRow(d)
					}
				</tbody>
			</table>
		}
	</section>
}

templ documentRow(d DocumentView) {
	<tr>
		<td><a href={ templ.SafeURL("/documents/" + d.ID) }>{ d.Filename }</a></td>
		<td><span class={ "pill", "pill-" + d.Status }>{ d.Status }</span></td>
		<td>{ d.SizeHuman }</td>
		<td>{ d.CreatedAt }</td>
		<td class="row-actions">
            <a class="btn btn-ghost btn-sm" href={ templ.SafeURL("/documents/" + d.ID) }>View</a>
            if d.IsDraft {
                <button
                    class="btn btn-danger btn-sm"
                    hx-post={ "/documents/" + d.ID + "/delete" }
                    hx-target="#doc-list"
                    hx-swap="outerHTML"
                    hx-confirm={ fmt.Sprintf("Delete draft %q? This can't be undone.", d.Filename) }
                >Delete</button>
            }
            </td>
	</tr>
}

templ DocumentDetail(nav Nav, d DocumentView, roster SignerRoster, errMsg string) {
	@Layout(d.Filename, nav) {
		<p><a href="/dashboard">← Back to documents</a></p>
		<section class="card">
			<div class="doc-head">
				<h1>{ d.Filename }</h1>
				<span class={ "pill", "pill-" + d.Status }>{ d.Status }</span>
			</div>
			<dl class="meta">
				<dt>Type</dt>
				<dd>{ d.ContentType }</dd>
				<dt>Size</dt>
				<dd>{ d.SizeHuman }</dd>
				<dt>Uploaded</dt>
				<dd>{ d.CreatedAt }</dd>
				<dt>SHA-256</dt>
				<dd><code class="hash">{ d.FileHash }</code></dd>
			</dl>
			<div class="cta-row">
				<a class="btn btn-primary" href={ templ.SafeURL("/documents/" + d.ID + "/download") }>Download</a>
				if d.IsDraft {
					<form method="post" action={ templ.SafeURL("/documents/" + d.ID + "/delete") } class="inline-form">
						@authCSRF(nav.CSRFToken)
						<button class="btn btn-danger" type="submit">Delete draft</button>
					</form>
				}
			</div>
		</section>
		if d.IsDraft {
        			<section class="card">
        				<h2>Invite signers</h2>
        				<p class="muted">Enter one or more email addresses. Sending will move this
        					document from <em>draft</em> to <em>sent</em> and email each signer a
        					private signing link.</p>
        				if errMsg != "" {
        					<div class="flash flash-error">{ errMsg }</div>
        				}
        				<form method="post" action={ templ.SafeURL("/documents/" + d.ID + "/invite") } class="form">
        					@authCSRF(nav.CSRFToken)
        					<div class="field">
        						<label for="emails">Signer emails (one per line, or comma-separated)</label>
        						<textarea id="emails" name="emails" rows="3" placeholder="alice@example.com&#10;bob@example.com" required></textarea>
        					</div>
        					<button class="btn btn-primary" type="submit">Send for signature</button>
        				</form>
        			</section>
        		} else {
        			<section class="card">
        				<h2>Signers <span class="muted">({ fmt.Sprintf("%d of %d signed", roster.Signed, roster.Total) })</span></h2>
        				<table class="table">
        					<thead>
        						<tr>
        							<th>Email</th>
        							<th>Status</th>
        						</tr>
        					</thead>
        					<tbody>
        						for _, s := range roster.Signers {
        							<tr>
        								<td>{ s.Email }</td>
        								<td><span class={ "pill", "pill-" + s.Status }>{ s.Status }</span></td>
        							</tr>
        						}
        					</tbody>
        				</table>
        			</section>
        		}
	}
}